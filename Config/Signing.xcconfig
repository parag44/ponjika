// Signing settings for Ponjika.
//
// Most people don't need to touch anything here: pick your Team in Xcode
// (target → Signing & Capabilities) and the bundle ID is built from it, so
// it's unique to you — e.g. com.ponjika.ABCDE12345.
//
// To use a bundle ID of your own instead, create Config/Signing.local.xcconfig
// (git-ignored) from Config/Signing.local.xcconfig.example.

PONJIKA_BUNDLE_ID_PREFIX = com.ponjika.$(DEVELOPMENT_TEAM)

#include? "Signing.local.xcconfig"
